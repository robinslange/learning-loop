{
  "name": "learning-loop",
  "version": "2.2.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Self-improving learning loop across Claude sessions",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test tests/*.test.mjs tests/**/*.test.mjs",
    "lint": "eslint .",
    "bench": "node bench/bench.mjs",
    "bench:quick": "node bench/bench.mjs --quick",
    "bench:baseline": "node bench/bench.mjs --save-baseline",
    "test:mutation": "node bench/mutation.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "eslint": "^9.39.4",
    "msw": "^2.15.0",
    "prettier": "3.8.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
