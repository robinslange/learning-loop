{
  "description": "Learning Loop lifecycle hooks — retrieval, consolidation, vault write validation, backlinks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-nudge.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-label.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-check.js\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/web-guard.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool.js\"",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-read-retrieval.js\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "mcp__plugin_episodic-memory",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-search-tracking.js\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
