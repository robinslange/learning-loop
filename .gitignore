.DS_Store
**/.DS_Store

# Model cache (downloaded on first run, ~40MB)
plugin/scripts/.model-cache/

# Provenance event logs and summaries (local-only)
provenance/events-*.jsonl
provenance/summaries/

# Data files (local-only)
/data/

.config-applied
.config-state

docs/*
!docs/baseline/

# Planning artifacts (local-only)
.planning/

federation/.seed
federation/data/
federation/config.json
node_modules/
plugin/scripts/node_modules/
federation/node_modules/
federation/relay/node_modules/
native/node_modules/

# Wrangler local state (Cloudflare Workers dev)
native/.wrangler/

# Training data (adapter weights, pair datasets)
native/training_data/

# Spike scratch (eval sets, model downloads, ad-hoc runs)
native/crates/*/spikes/

.worktrees/

# Bench fixture caches (generated on first bench run — not committed)
bench/fixtures/.cache/
bench/fixtures/vault-10k/
bench/fixtures/vault-small/

# Criterion HTML reports (generated by cargo bench)
native/target/criterion/

# Test fixture databases (regenerated each test run)
tests/fixtures/**/.vault-search/

# Local artefacts (not committed)
.superpowers/
/coverage/
/calibration/
native/docs/
native/crates/ll-search/src/sync/test_write.txt

# Audit scratch (subagent fallback write dirs when /tmp is sandboxed)
.audit-tmp/
.tmp-audit/

# Local Claude Code state (worktrees, agents, settings)
.claude/
